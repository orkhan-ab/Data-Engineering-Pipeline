olymp-r:slice-year-2020 a qb:Slice ;
    qb:sliceStructure [ qb:dimension olymp:year ;
            qb:order 1 ] .

sdmx:refArea skos:prefLabel "Reference Area"@en .

sdmx:refPeriod skos:prefLabel "Reference Period"@en .

olymp:age a qb:MeasureProperty ;
    rdfs:label "Age"@en ;
    rdfs:range xsd:float .

olymp:country a qb:DimensionProperty,
        rdfs:Property ;
    rdfs:label "Country"@en ;
    qb:concept sdmx:refArea ;
    rdfs:range xsd:string .

olymp:structure a qb:DataStructureDefinition ;
    qb:component [ qb:dimension olymp:year ;
            qb:order 1 ],
        [ qb:dimension olymp:country ;
            qb:order 2 ],
        [ qb:measure olymp:age ] .

olymp:year a qb:DimensionProperty,
        rdfs:Property ;
    rdfs:label "Year"@en ;
    qb:concept sdmx:refPeriod ;
    rdfs:range xsd:int .

olymp-r:dataCubeInstance a qb:DataSet ;
    dcterms:issued "2024-04-01"^^xsd:date ;
    dcterms:license "https://gitlab.mff.cuni.cz/teaching/ndbi046/2024-25/orkhan-abilov/HW-3-Data-Cube/MIT Licence"^^xsd:anyURI ;
    dcterms:modified "2024-04-01"^^xsd:date ;
    dcterms:publisher "Orkhan Abilov"@en ;
    dcterms:title "Olympics Data Cube"@en ;
    qb:structure olymp:structure .

